# Application
APP_NAME=Recipes API
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./recipes.db

# JWT
JWT_SECRET_KEY=competition-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - permissive for competition
CORS_ORIGINS=["*"]

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=["image/jpeg", "image/png", "image/webp"]

# WebSocket
WS_HEARTBEAT_INTERVAL=30